# ==============================================================================
# Environment Configuration Template (Never commit actual secrets to Git)
# Copy this file to .env and fill in secure values for your environment:
#   cp .env.example .env
# ==============================================================================

# --- Project & Environment ---
PROJECT_NAME=ecommerce_data_platform
ENVIRONMENT=development

# --- PostgreSQL Data Warehouse ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=replace_with_strong_password_in_env

# --- MinIO (S3-Compatible Data Lake) ---
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_password_in_env
MINIO_BUCKET_NAME=ecommerce-lake

# --- Apache Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=false
_AIRFLOW_WWW_USER_USERNAME=airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=replace_with_strong_password_in_env

# --- Metabase BI ---
METABASE_PORT=3000
